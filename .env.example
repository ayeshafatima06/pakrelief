# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP EMAIL CONFIGURATION (Optional - to deliver OTPs directly to personal inboxes)
# If not provided, Nodemailer uses the real Ethereal test transport and provides an instant preview link & code.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
GMAIL_USER="your-email@gmail.com"
# STRIPE SANDBOX CONFIGURATION
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_..."
CLIENT_URL="http://localhost:3000"

# SAFEPAY PAYMENT GATEWAY (server-side secrets only — never expose these in frontend code)
# Merchant signup (sandbox): https://sandbox.api.getsafepay.com/dashboard/signup
# Secret/Public keys: Safepay Dashboard -> Developers.
# Webhook secret: Dashboard -> Developers -> Endpoints -> View shared secret.
# Register the webhook endpoint URL as: https://<your-host>/api/payments/safepay/webhook
# Leave the three keys blank until provided; checkout returns 503 until all are configured.
SAFEPAY_SECRET_KEY=""
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
# 'sandbox' (default) or 'production'. Use sandbox for testing; never use production keys in dev.
SAFEPAY_ENVIRONMENT="sandbox"
# Optional absolute base URL for the SPA return/cancel redirects. Falls back to APP_URL, then
# CLIENT_URL, then http://localhost:3000. The redirect is a UI hint only, never proof of payment.
SAFEPAY_RETURN_URL_BASE=""

# ADMIN AUTHORIZATION (server-side). Comma-separated Firebase UIDs permitted to act as NDMA admin.
# Authorization uses this allowlist + the trusted Firestore profile role; custom claims are not trusted.
PAKRELIEF_ADMIN_UIDS=""
# Optional bootstrap password for provisioning the initial admin account; leave blank in production.
PAKRELIEF_ADMIN_BOOTSTRAP_PASSWORD=""
# PROFILE RECOVERY (server-side). Comma-separated Firebase UIDs whose missing Firestore profile may be
# repaired via POST /api/auth/recover-profile. Leave blank (recovery disabled) except during a supervised repair.
PAKRELIEF_RECOVERY_UIDS=""

# META GRAPH API (server-side secrets only; configure through the hosting secret manager)
# Never commit a real token here. Provide it via the hosting secret manager / local .env only.
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v27.0"
META_PAGE_ID="1466897083167292"
META_INSTAGRAM_ACCOUNT_ID=""

# WHATSAPP BUSINESS CLOUD API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Must be an approved marketing template with three text body parameters:
# campaign title, location, and campaign description/link.
WHATSAPP_CAMPAIGN_TEMPLATE_NAME="approved_campaign_notice"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Optional absolute base URL used when constructing public campaign links.
PAKRELIEF_PUBLIC_CAMPAIGN_URL=""
